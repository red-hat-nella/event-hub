# Puerto HTTP expuesto por el contenedor (Service interno, sin Route propia)
PORT=3000

# Cadena de conexión a la base de datos propia db-registrations (nunca
# compartida con otro microservicio)
DATABASE_URL=postgresql://registration_service:change-me@db-registrations:5432/registrations?schema=public

# URL interna (ClusterIP) de event-service — único servicio del que
# registration-service actúa como cliente HTTP (reserve/release/getEvent)
EVENT_SERVICE_URL=http://event-service:3000

# Cabecera de defensa en profundidad enviada/exigida en toda llamada interna
# (Secret `internal-service-token`, clave `token`)
INTERNAL_SERVICE_TOKEN=change-me-in-a-managed-secret

# Nivel de log estructurado JSON
LOG_LEVEL=info
