# Puerto HTTP del servicio (por defecto 3000 si no se define)
PORT=3000

# Cadena de conexión PostgreSQL de la base de datos db-users
DATABASE_URL=postgresql://user_service:changeme@localhost:5432/db_users?schema=public

# Secreto compartido HMAC-SHA256 usado para firmar/verificar accessToken y refreshToken
# (debe coincidir con el Secret jwt-signing-key usado por api-gateway)
JWT_SECRET=changeme-jwt-secret

# Token compartido para defensa en profundidad entre servicios internos
# (debe coincidir con el Secret internal-service-token del resto de servicios)
INTERNAL_SERVICE_TOKEN=changeme-internal-token

# Credenciales de la cuenta administradora sembrada de forma idempotente al arrancar
SEED_ADMIN_EMAIL=admin@event-hub.local
SEED_ADMIN_PASSWORD=changeme-admin-password

# Nivel de logs de la aplicación
LOG_LEVEL=info
