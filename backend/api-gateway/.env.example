# Puerto HTTP expuesto por el contenedor (Service interno, sin Route propia)
PORT=3000

# URLs internas (ClusterIP) de los servicios de dominio
USER_SERVICE_URL=http://user-service:3000
EVENT_SERVICE_URL=http://event-service:3000
REGISTRATION_SERVICE_URL=http://registration-service:3000

# Secreto compartido para verificar JWT HS256 emitidos por user-service
# (Secret `jwt-signing-key`, clave `secret`)
JWT_SECRET=change-me-in-a-managed-secret

# Cabecera de defensa en profundidad enviada en toda llamada interna
# (Secret `internal-service-token`, clave `token`)
INTERNAL_SERVICE_TOKEN=change-me-in-a-managed-secret

# TTL de cookies (ms) — deben reflejar el TTL real de los JWT emitidos
# por user-service (accessToken 30 min, refreshToken 7 dias)
ACCESS_TOKEN_TTL_MS=1800000
REFRESH_TOKEN_TTL_MS=604800000

# Nivel de log estructurado JSON
LOG_LEVEL=info
