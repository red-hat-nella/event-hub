server {
  listen       8080;
  server_name  _;

  root   /usr/share/nginx/html;
  index  index.html;

  location = /healthz {
    access_log off;
    return 200 "ok";
    add_header Content-Type text/plain;
  }

  # Único punto de entrada externo (research.md §16): todo /api/* se
  # reenvía al Service interno de api-gateway. El frontend nunca conoce
  # ni depende de endpoints de los microservicios internos.
  location /api/ {
    proxy_pass ${API_GATEWAY_URL}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SPA: cualquier ruta que no exista como archivo estático cae en
  # index.html para que React Router resuelva el árbol de `router.tsx`.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
