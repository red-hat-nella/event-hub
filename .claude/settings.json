{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./tools/sdd-deliver.sh *)",
      "Bash(${CLAUDE_PROJECT_DIR}/tools/sdd-deliver.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/sdd-claude-hook.sh",
            "args": ["protect-constitution"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "speckit-implement",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/sdd-claude-hook.sh",
            "args": ["begin"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/sdd-claude-hook.sh",
            "args": ["stop"],
            "timeout": 7500,
            "statusMessage": "Validando y entregando la aplicación mediante SDD"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/sdd-claude-hook.sh",
            "args": ["self-check"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
